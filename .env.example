# Port prefix — all service ports use this as a prefix
# e.g. prefix=3 → backend 38000, frontend 35173, postgres 35432
MINI_HELP_DESK_PORT_PREFIX=3

# PostgreSQL
MINI_HELP_DESK_DB_NAME=helpdesk
MINI_HELP_DESK_DB_USER=helpdesk
MINI_HELP_DESK_DB_PASSWORD=helpdesk
# Hostname of the postgres service. Defaults to "db" (Docker internal).
# Override only if connecting to an external postgres instance.
MINI_HELP_DESK_DB_HOST=db

# LLM configuration
LLM_API_KEY=your-api-key-here
# Base URL for a custom/self-hosted LLM endpoint (OpenAI-compatible).
# Leave empty to use the default OpenAI API.
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini